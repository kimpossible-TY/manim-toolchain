GEMINI_API_KEY=replace-with-your-gemini-api-key

# Keep the API key in the launching shell (for example, exported by ~/.zshrc),
# not in this file: export RUNPOD_API_KEY='replace-with-your-runpod-api-key'
# Runpod/R2 settings below are read only by visual-runpod. Keep .env chmod 600.
# Pod image (prefer an immutable digest) and a Runpod GPU type ID, for example
# RUNPOD_POD_GPU_ID=NVIDIA GeForce RTX 4090
RUNPOD_POD_IMAGE=ghcr.io/kimpossible-ty/manim-blender-worker@sha256:3d33302c2c79371832cf320514c2b8a112b0a435a92b22af7779bbadb9acec78
RUNPOD_POD_GPU_ID=replace-with-your-runpod-gpu-id
RUNPOD_POD_CONTAINER_DISK_GB=30
# Local wait/cost budget; current runpodctl may not expose a create-time guard.
RUNPOD_POD_TERMINATE_AFTER=8h
# Optional: RUNPOD_REGISTRY_AUTH_ID=... and RUNPOD_POD_DATA_CENTER_IDS=...,...
R2_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_BUCKET=manim-render
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
R2_PREFIX=manim-render
R2_URL_EXPIRY_SECONDS=86400
