GEMINI_API_KEY=replace-with-your-gemini-api-key

# Runpod/R2 credentials are read only by visual-runpod. Keep .env chmod 600.
RUNPOD_API_KEY=replace-with-your-runpod-api-key
RUNPOD_ENDPOINT_ID=replace-with-your-serverless-endpoint-id
R2_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_BUCKET=manim-render
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
R2_PREFIX=manim-render
R2_URL_EXPIRY_SECONDS=86400
