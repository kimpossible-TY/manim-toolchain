#!/usr/bin/env bash
set -euo pipefail

readonly TOOLCHAIN_DIR="/Users/taeyoung/Developer/manim-toolchain"

if [[ ! -f "$TOOLCHAIN_DIR/scripts/compose_video.py" ]]; then
    printf 'Composition helper script is missing: %s/scripts/compose_video.py\n' "$TOOLCHAIN_DIR" >&2
    exit 1
fi

exec python3 "$TOOLCHAIN_DIR/scripts/compose_video.py" "$@"
