#!/usr/bin/env bash
set -euo pipefail

readonly TOOLCHAIN_DIR="/Users/taeyoung/Developer/visual-explainer-toolchain"

if [[ ! -f "$TOOLCHAIN_DIR/pyproject.toml" || ! -f "$TOOLCHAIN_DIR/uv.lock" ]]; then
    printf 'Central Manim toolchain is incomplete: %s\n' "$TOOLCHAIN_DIR" >&2
    exit 1
fi

# The wrapper must never inherit project selection or an active environment
# from the caller. Unsetting these affects only this child process.
unset VIRTUAL_ENV
unset UV_PROJECT UV_PROJECT_ENVIRONMENT
unset UV_WORKING_DIR UV_WORKING_DIRECTORY
unset UV_ENV_FILE UV_NO_ENV_FILE UV_PYTHON
# Keep cloud storage and Runpod control-plane credentials exclusive to the
# dedicated Runpod wrapper, even when the caller's shell exports them.
unset RUNPOD_API_KEY RUNPOD_ENDPOINT_ID RUNPOD_API_BASE_URL
unset R2_ACCOUNT_ID R2_BUCKET R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY
unset R2_ENDPOINT_URL R2_PREFIX R2_URL_EXPIRY_SECONDS

UV_BIN="$(command -v uv)"

if [[ -f "$TOOLCHAIN_DIR/.env" ]]; then
    credential_mode="$(stat -f '%Lp' "$TOOLCHAIN_DIR/.env")"
    case "$credential_mode" in
        400|600) ;;
        *)
            printf 'Refusing to load %s with permissions %s; run chmod 600 on it.\n' \
                "$TOOLCHAIN_DIR/.env" "$credential_mode" >&2
            exit 1
            ;;
    esac

    filtered_env_file="$(mktemp "${TMPDIR:-/tmp}/manim-video-env.XXXXXX")"
    chmod 600 "$filtered_env_file"
    trap 'rm -f "$filtered_env_file"' EXIT
    grep -E '^[[:space:]]*(GEMINI_API_KEY|GOOGLE_API_KEY|GEMINI_AUTH_MODE|GOOGLE_CLOUD_PROJECT|GOOGLE_CLOUD_LOCATION|GOOGLE_APPLICATION_CREDENTIALS)[[:space:]]*=' \
        "$TOOLCHAIN_DIR/.env" > "$filtered_env_file" || true
    exec "$UV_BIN" run \
        --project "$TOOLCHAIN_DIR" \
        --frozen \
        --no-managed-python \
        --env-file "$filtered_env_file" \
        -- manim "$@"
fi

exec "$UV_BIN" run \
    --project "$TOOLCHAIN_DIR" \
    --frozen \
    --no-managed-python \
    --no-env-file \
    -- manim "$@"
