#!/usr/bin/env bash
set -euo pipefail

readonly DEFAULT_SESSION_NAME="visual-render"

usage() {
    cat <<'USAGE'
Usage: visual-colab-stop [--session NAME]

Stops the named reusable Colab session. The default is visual-render.
COLAB_SESSION may also provide the session name.
USAGE
}

session_name="${COLAB_SESSION:-$DEFAULT_SESSION_NAME}"
while (($# > 0)); do
    case "$1" in
        --session|-s)
            if (($# < 2)); then
                printf '%s\n' 'Missing session name.' >&2
                usage >&2
                exit 64
            fi
            session_name="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            usage >&2
            exit 64
            ;;
    esac
done

if [[ -z "$session_name" || "$session_name" == *$'\n'* || "$session_name" == *$'\r'* ]]; then
    printf '%s\n' 'Session name must be non-empty and single-line.' >&2
    exit 64
fi
if ! command -v colab >/dev/null 2>&1; then
    printf '%s\n' 'Colab CLI is not installed or not on PATH.' >&2
    exit 127
fi

printf 'COLAB_SESSION_STOP_REQUESTED=%s\n' "$session_name"
exec colab stop -s "$session_name"
