#!/usr/bin/env bash
set -euo pipefail

readonly TOOLCHAIN_DIR="/Users/taeyoung/Developer/visual-explainer-toolchain"

if [[ ! -f "$TOOLCHAIN_DIR/pyproject.toml" || ! -f "$TOOLCHAIN_DIR/uv.lock" ]]; then
    printf 'Central visualization toolchain is incomplete: %s\n' "$TOOLCHAIN_DIR" >&2
    exit 1
fi

# Select only the central Python environment. Keep the caller's working
# directory, project files, and unrelated virtual environment untouched.
unset VIRTUAL_ENV
unset UV_PROJECT UV_PROJECT_ENVIRONMENT
unset UV_WORKING_DIR UV_WORKING_DIRECTORY
unset UV_ENV_FILE UV_NO_ENV_FILE UV_PYTHON

# PyGfx and Taichi do not need narration credentials. Keep the credential
# surface exclusive to manim-video and its central dotenv policy.
unset GEMINI_API_KEY GOOGLE_API_KEY GEMINI_AUTH_MODE
unset GOOGLE_CLOUD_PROJECT GOOGLE_CLOUD_LOCATION GOOGLE_APPLICATION_CREDENTIALS
# Cloud storage and control-plane credentials belong only to visual-runpod.
# In particular, do not leak them into an external project's Python process.
unset RUNPOD_API_KEY RUNPOD_ENDPOINT_ID RUNPOD_API_BASE_URL
unset RUNPOD_POD_IMAGE RUNPOD_POD_GPU_ID RUNPOD_POD_CONTAINER_DISK_GB
unset RUNPOD_POD_TERMINATE_AFTER RUNPOD_POD_DATA_CENTER_IDS RUNPOD_REGISTRY_AUTH_ID RUNPODCTL_BIN
unset R2_ACCOUNT_ID R2_BUCKET R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY
unset R2_ENDPOINT_URL R2_PREFIX R2_URL_EXPIRY_SECONDS

UV_BIN="$(command -v uv)"

exec "$UV_BIN" run \
    --project "$TOOLCHAIN_DIR" \
    --frozen \
    --no-managed-python \
    --no-env-file \
    -- python "$@"
