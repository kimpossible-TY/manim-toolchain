#!/usr/bin/env bash
set -euo pipefail

readonly TOOLCHAIN_DIR="/Users/taeyoung/Developer/manim-toolchain"

if [[ ! -f "$TOOLCHAIN_DIR/scripts/blender_render.py" ]]; then
    printf 'Central Blender render helper is missing: %s\n' "$TOOLCHAIN_DIR" >&2
    exit 1
fi

# If --workers is specified, route through parallel_blender_render.py
for arg in "$@"; do
    if [[ "$arg" == "--workers" || "$arg" =~ ^--workers= ]]; then
        exec python3 "$TOOLCHAIN_DIR/scripts/parallel_blender_render.py" \
            --blender-bin "$TOOLCHAIN_DIR/bin/visual-blender" \
            "$@"
    fi
done

# Otherwise execute single-worker render
exec "$TOOLCHAIN_DIR/bin/visual-blender" \
    --background \
    --python "$TOOLCHAIN_DIR/scripts/blender_render.py" \
    -- \
    --mode render \
    --engine cycles \
    "$@"
