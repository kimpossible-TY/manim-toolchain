#!/usr/bin/env bash
set -euo pipefail

# Direct, transparent access to the installed Blender executable.  This wrapper
# deliberately does not activate the central uv environment or load dotenv
# files; Blender scripts run with Blender's bundled Python.
unset RUNPOD_API_KEY RUNPOD_ENDPOINT_ID RUNPOD_API_BASE_URL
unset R2_ACCOUNT_ID R2_BUCKET R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY
unset R2_ENDPOINT_URL R2_PREFIX R2_URL_EXPIRY_SECONDS
if [[ -n "${BLENDER_BIN:-}" ]]; then
    blender_bin="$BLENDER_BIN"
elif command -v blender >/dev/null 2>&1; then
    blender_bin="$(command -v blender)"
elif [[ -x /Applications/Blender.app/Contents/MacOS/Blender ]]; then
    blender_bin="/Applications/Blender.app/Contents/MacOS/Blender"
else
    printf '%s\n' 'Blender is not installed. Install the native macOS application or a Homebrew cask.' >&2
    exit 127
fi

# Blender 5.x on macOS initializes the Metal display backend before it runs a
# Python expression or script, including in background mode.  Restricted
# process sandboxes can hide the hardware identity that Metal exposes.  The
# Blender 5.2 release build then dereferences the missing device name while
# checking GPU support and exits with SIGSEGV.  A child wrapper cannot grant
# itself host access, so fail before Blender starts and tell the caller to
# relaunch this wrapper outside the sandbox.
if [[ "$(uname -s)" == "Darwin" ]] && \
   ! /usr/sbin/sysctl -n hw.cpufamily >/dev/null 2>&1; then
    printf '%s\n' \
        'visual-blender: macOS hardware access is restricted in this process.' \
        'Blender 5.x may crash during Metal device detection before Python starts.' \
        'Run the visual-blender wrapper with host/outside-sandbox execution permission.' >&2
    exit 77
fi

exec "$blender_bin" "$@"
